{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brids.app/schemas/content-frontmatter.schema.json",
  "title": "BRIDS Content Frontmatter",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "status",
    "type",
    "version",
    "updatedAt",
    "tags",
    "canonicalPath"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "superseded"]
    },
    "type": {
      "type": "string",
      "enum": [
        "institutional-page",
        "article",
        "knowledge-base",
        "faq",
        "glossary-term",
        "changelog"
      ]
    },
    "version": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 10 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalPath": {
      "type": "string",
      "pattern": "^/"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "supersededBySlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "superseded" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["supersededBySlug"]
      }
    }
  ],
  "additionalProperties": false
}
