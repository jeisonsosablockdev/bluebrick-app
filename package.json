{
  "name": "brids",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "reasoning-agent": "./lib/reasoning-agent/cli.ts"
  },
  "scripts": {
    "predev": "node ./scripts/db-migrate-if-configured.js",
    "dev": "next dev --webpack",
    "predev:turbo": "node ./scripts/db-migrate-if-configured.js",
    "dev:turbo": "next dev --turbo",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "node ./scripts/patch-synpress-phantom-peer.js",
    "db:migrate": "node ./scripts/db-migrate.js",
    "db:migrate:check": "node ./scripts/db-migrate.js --check",
    "cm:items": "node ./scripts/check-candy-machine-items.js",
    "collection:bootstrap:dry-run": "tsx ./scripts/collection-bootstrap-dry-run.ts",
    "purchase:trace": "node ./scripts/purchase-trace.js",
    "rfc:new": "node ./scripts/rfc-new.js",
    "linear:plan": "node ./scripts/linear-plan.js",
    "linear:issue-status": "node ./scripts/linear-status.js",
    "linear:issue-start": "node ./scripts/linear-status.js --state start",
    "linear:issue-review": "node ./scripts/linear-status.js --state review",
    "linear:issue-done": "node ./scripts/linear-status.js --state done",
    "mcp:linear": "tsx ./scripts/linear-mcp-server.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:harness": "vitest run --config tests/harness/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "typegen": "next typegen",
    "validate": "pnpm lint && pnpm typecheck && pnpm check:licenses && pnpm validate:db && pnpm validate:content && pnpm validate:pipeline && pnpm validate:routes && pnpm validate:seo && pnpm validate:schema && pnpm validate:ai && pnpm validate:feeds && pnpm validate:operability && pnpm validate:knowledge && pnpm validate:workflow && pnpm validate:docs-governance && pnpm validate:architecture && pnpm task:check",
    "validate:architecture": "bash ./scripts/ci/check-layered-architecture.sh",
    "check:licenses": "tsx ./scripts/ci/check-licenses.ts",
    "knowledge:licenses": "tsx ./scripts/knowledge/generate-license-report.ts",
    "validate:db": "node ./scripts/db-validate.js",
    "validate:content": "vitest run tests/lib/content-contracts.test.ts",
    "validate:pipeline": "vitest run tests/lib/content-pipeline-serialization.test.ts",
    "validate:routes": "vitest run tests/lib/content-routes.test.ts",
    "validate:seo": "vitest run tests/lib/seo-metadata.test.ts tests/lib/seo-routes.test.ts",
    "validate:schema": "vitest run tests/lib/schema-emitters.test.ts tests/lib/schema-template-emitters.test.ts",
    "validate:ai": "vitest run tests/lib/ai-readable-contracts.test.ts tests/api/ai-readable-endpoints.test.ts",
    "validate:feeds": "vitest run tests/lib/feed-search-contracts.test.ts tests/api/feeds-endpoints.test.ts",
    "validate:operability": "vitest run tests/lib/security-headers.test.ts tests/lib/observability-store.test.ts tests/lib/semantic-extension-contract.test.ts tests/api/analytics-events-route.test.ts tests/api/health-route.test.ts tests/api/admin-monitoring-analytics-route.test.ts tests/api/admin-monitoring-logs-route.test.ts",
    "validate:knowledge": "vitest run tests/lib/knowledge-system.test.ts && tsx ./scripts/knowledge/build-knowledge-index.ts --check && tsx ./scripts/knowledge/validate-candy-machine-deploy-iteration.ts",
    "validate:workflow": "vitest run tests/lib/workflow-evals.test.ts",
    "validate:docs-governance": "bash ./scripts/ci/validate-doc-governance.sh",
    "preflight:start": "bash ./scripts/ci/preflight-start.sh",
    "task:init": "bash ./scripts/task-init.sh",
    "task:check": "bash ./scripts/ci/check-task-lifecycle.sh",
    "graphify:sync": "node ./scripts/graphify-sync.js",
    "knowledge:scan": "tsx ./scripts/knowledge/scan-recent-changes.ts",
    "knowledge:index": "tsx ./scripts/knowledge/build-knowledge-index.ts",
    "knowledge:drift": "tsx ./scripts/knowledge/detect-governance-drift.ts",
    "pr:ready": "bash ./scripts/ci/pr-ready.sh",
    "pr:metadata": "bash ./scripts/ci/pr-metadata-lint.sh",
    "pr:open": "bash ./scripts/ci/pr-open.sh",
    "pr:auto": "bash ./scripts/ci/pr-auto.sh",
    "e2e:install": "playwright install chromium",
    "e2e:playwright": "playwright test --project=playwright-smoke",
    "e2e:synpress:cache": "node ./scripts/synpress-prepare-phantom-extension.js && synpress --phantom --headless e2e/wallet-setup",
    "e2e:synpress": "pnpm e2e:synpress:cache && playwright test --project=synpress-phantom",
    "e2e:synpress:user": "E2E_SYNPRESS_WALLET_ROLE=user pnpm e2e:synpress",
    "e2e:synpress:admin": "E2E_SYNPRESS_WALLET_ROLE=admin pnpm e2e:synpress",
    "e2e:roles": "playwright test e2e/admin-role-access.pw.spec.ts --project=playwright-smoke",
    "e2e:evidence": "playwright test e2e/critical-path.evidence.pw.spec.ts --project=playwright-smoke && node ./scripts/e2e-evidence-index.js",
    "e2e": "pnpm e2e:playwright && pnpm e2e:synpress"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@metaplex-foundation/mpl-core": "^1.7.0",
    "@metaplex-foundation/mpl-core-candy-machine": "^0.3.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@solana/kit": "^2.3.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@vercel/blob": "^2.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "@workos-inc/authkit-nextjs": "^4.0.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.24.0",
    "mapbox-gl": "^3.24.0",
    "motion": "^12.40.0",
    "next": "^16.2.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "spark-md5": "^3.0.2",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zod4": "npm:zod@^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@synthetixio/synpress": "^4.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.13.10",
    "@types/pg": "^8.18.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/spark-md5": "^3.0.5",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.28.0",
    "eslint": "9.21.0",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.1.0",
    "playwright-core": "^1.59.1",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.6",
    "typescript": "5.8.2",
    "vitest": "^4.1.5",
    "yaml": "^2.9.0"
  }
}
