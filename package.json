{
  "name": "solana-test-1-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "build": "next build --webpack",
    "start": "next start",
    "db:migrate": "node ./scripts/db-migrate.js",
    "cm:items": "node ./scripts/check-candy-machine-items.js",
    "purchase:trace": "node ./scripts/purchase-trace.js",
    "rfc:new": "node ./scripts/rfc-new.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "validate": "npm run lint && npm run typecheck && npm run validate:content && npm run validate:routes && npm run validate:seo && npm run validate:schema && npm run validate:docs-governance",
    "validate:content": "vitest run tests/lib/content-contracts.test.ts",
    "validate:routes": "vitest run tests/lib/content-routes.test.ts",
    "validate:seo": "vitest run tests/lib/seo-metadata.test.ts tests/lib/seo-routes.test.ts",
    "validate:schema": "vitest run tests/lib/schema-emitters.test.ts tests/lib/schema-template-emitters.test.ts",
    "validate:docs-governance": "bash ./scripts/ci/validate-doc-governance.sh",
    "pr:ready": "bash ./scripts/ci/pr-ready.sh",
    "e2e:install": "playwright install chromium",
    "e2e:playwright": "playwright test --project=playwright-smoke",
    "e2e:synpress:cache": "node ./scripts/synpress-prepare-phantom-extension.js && synpress --phantom --headless test/wallet-setup",
    "e2e:synpress": "npm run e2e:synpress:cache && playwright test --project=synpress-phantom",
    "e2e:synpress:user": "E2E_SYNPRESS_WALLET_ROLE=user npm run e2e:synpress",
    "e2e:synpress:admin": "E2E_SYNPRESS_WALLET_ROLE=admin npm run e2e:synpress",
    "e2e:roles": "playwright test e2e/admin-role-access.pw.spec.ts --project=playwright-smoke",
    "e2e:evidence": "playwright test e2e/critical-path.evidence.pw.spec.ts --project=playwright-smoke && node ./scripts/e2e-evidence-index.js",
    "e2e": "npm run e2e:playwright && npm run e2e:synpress"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.7.0",
    "@metaplex-foundation/mpl-core-candy-machine": "^0.3.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@solana/kit": "^2.3.0",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@vercel/blob": "^2.3.3",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "next": "^16.1.6",
    "pg": "^8.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "spark-md5": "^3.0.2",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@synthetixio/synpress": "^4.1.2",
    "@types/node": "22.13.10",
    "@types/pg": "^8.18.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/spark-md5": "^3.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.21.0",
    "eslint-config-next": "^16.1.6",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  }
}
