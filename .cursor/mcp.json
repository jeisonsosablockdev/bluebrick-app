{
  "mcpServers": {
    "solanaMcp": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.solana.com/mcp"]
    },
    "helius": {
      "command": "npx",
      "args": ["helius-mcp@latest"]
    },
    "mapboxDevKit": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp-devkit.mapbox.com/mcp"]
    },
    "linear": {
      "command": "npx",
      "args": ["tsx", "./scripts/linear-mcp-server.ts"]
    }
  }
}
