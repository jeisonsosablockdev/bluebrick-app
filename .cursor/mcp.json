{
  "mcpServers": {
    "solanaMcp": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.solana.com/mcp"]
    },
    "helius": {
      "command": "bash",
      "args": ["-lc", "set -a; [ -f .env.local ] && . ./.env.local; set +a; exec npx helius-mcp@latest"]
    },
    "mapboxDevKit": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp-devkit.mapbox.com/mcp"]
    }
  }
}
