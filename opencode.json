{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "tsx",
        "./scripts/linear-mcp-server.ts"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker"
      ],
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PAT}"
      },
      "enabled": true
    },
    "mapbox": {
      "type": "remote",
      "url": "https://mcp-devkit.mapbox.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MAPBOX_ACCESS_TOKEN}"
      },
      "enabled": true
    }
  }
}